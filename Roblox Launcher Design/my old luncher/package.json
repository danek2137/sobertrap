{
  "name": "oxevy-luncher",
  "version": "1.0.0",
  "description": "Oxevy Minecraft Launcher with Fabric support",
  "author": "Oxevy Team",
  "main": "src/main/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "npm run build && electron .",
    "start:electron": "electron . --dev-server=http://127.0.0.1:3000",
    "dev:all": "concurrently \"npm run dev\" \"wait-on http://127.0.0.1:3000 && npm run start:electron\"",
    "pack:linux": "electron-builder --linux",
    "compile:injector": "cd src\\injector && cl /nologo /EHsc /Fe:inject.exe inject.cpp /link kernel32.lib user32.lib || g++ -static -O2 -o src/injector/inject.exe src/injector/inject.cpp",
    "pack:win": "npm run compile:injector && electron-builder --win",
    "pack:all": "electron-builder --linux --win",
    "install:linux": "cd ../../scripts && bash install-linux.sh",
    "install:win": "cd ../../scripts && install-win.bat"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "discord-rpc": "^4.0.1",
    "dotenv": "^17.4.2",
    "electron-is-dev": "^3.0.1",
    "express": "^5.2.1",
    "framer-motion": "^11.2.10",
    "gtk": "^0.0.1",
    "lucide-react": "^0.395.0",
    "minecraft-launcher-core": "^3.0.2",
    "node-fetch": "^2.7.0",
    "prismarine-auth": "^3.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "electron": "^31.0.1",
    "electron-builder": "^24.13.3",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "vite": "^5.3.1",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.oxevy.luncher",
    "productName": "Oxevy Launcher",
    "directories": {
      "output": "dist-electron"
    },
    "icon": "build/X.png",
    "files": [
      "dist/**/*",
      "src/main/**/*",
      "src/injector/inject.exe",
      "node_modules/minecraft-launcher-core/**/*",
      "node_modules/node-fetch/**/*"
    ],
    "extraResources": [
      {
        "from": "src/injector/",
        "to": "injector/",
        "filter": ["inject.exe"]
      }
    ],
    "linux": {
      "target": "AppImage",
      "category": "Game",
      "artifactName": "Oxevy-Launcher-${version}.${ext}"
    },
    "win": {
      "target": "nsis",
      "artifactName": "Oxevy-Launcher-Setup-${version}.${ext}"
    }
  }
}
